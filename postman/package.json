{
  "name": "designerjobs-postman",
  "version": "1.0.0",
  "private": true,
  "description": "Black-box API tests for DesignerJobs.com, runnable headless via Newman.",
  "scripts": {
    "test:api": "newman run DesignerJobs.postman_collection.json -e DesignerJobs.local.postman_environment.json",
    "test:api:html": "newman run DesignerJobs.postman_collection.json -e DesignerJobs.local.postman_environment.json -r cli,html --reporter-html-export newman-report.html"
  },
  "devDependencies": {
    "newman": "^6.2.2",
    "newman-reporter-html": "^1.0.5"
  }
}
